PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_market

# Generate private random values with at least 32 bytes each.
PASSWORD_HASH_KEY=
AUTH_TOKEN_SECRET=

# Asistente de IA (Gemini). Crea la clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.5-flash-lite).
GEMINI_MODEL=

# Proveedor predeterminado: gemini u ollama. El usuario puede elegir entre
# proveedores configurados; no se cambia automáticamente a otro proveedor.
AI_PROVIDER=gemini
# Configura el nombre instalado en Ollama para habilitar la opción local.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Otros modelos descargados, separados por comas; el cliente elige de esta lista.
OLLAMA_MODELS=
