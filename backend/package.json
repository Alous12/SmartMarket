{
  "name": "smartmarket-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run migrate && tsx watch src/server.ts",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "npm run migrate && node dist/server.js",
    "migrate": "prisma migrate deploy --config prisma7.config.ts",
    "generate": "prisma generate --config prisma7.config.ts",
    "postinstall": "prisma generate --config prisma7.config.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.6",
    "express": "^5.1.0",
    "mysql2": "^3.24.5",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
